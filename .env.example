# ============================================================
# KOJO FINANCIAL OS — Environment Variables Template
# Copy to .env.local and fill in values. NEVER commit .env.local
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/kojo_financial_os"
DATABASE_DIRECT_URL="postgresql://user:password@localhost:5432/kojo_financial_os"

# --- NextAuth v5 ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_SECRET="generate-with: openssl rand -base64 32"

# --- Anthropic AI ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Encryption (AES-256 for SSN and sensitive fields) ---
ENCRYPTION_KEY="generate-with: openssl rand -hex 32"
ENCRYPTION_IV_SEED="generate-with: openssl rand -hex 16"

# --- Plaid (optional — bank linking) ---
PLAID_CLIENT_ID=""
PLAID_SECRET_SANDBOX=""
PLAID_SECRET_PRODUCTION=""
PLAID_ENV="sandbox"

# --- Document Storage ---
# Option A: Local filesystem (development)
DOCUMENT_STORAGE_TYPE="local"
DOCUMENT_STORAGE_PATH="./storage/documents"

# Option B: AWS S3 (production)
# DOCUMENT_STORAGE_TYPE="s3"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="kojo-financial-os-docs"

# --- Email (password reset links, alerts) ---
# Gmail: host smtp.gmail.com, port 465, user = your Gmail, password = a Google App Password
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""
# Base URL used in reset links (where you open AXIOM), e.g. http://100.106.143.81:3000
APP_BASE_URL="http://localhost:3000"

# --- App Config ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Kojo Financial OS"

# --- Security ---
RATE_LIMIT_REQUESTS_PER_MINUTE="60"
SESSION_MAX_AGE_SECONDS="86400"

# --- Live data sync (Shopify → Mi Meba Shop) ---
SHOPIFY_STORE_DOMAIN=""          # e.g. yourstore.myshopify.com
SHOPIFY_CLIENT_ID=""             # Dev Dashboard app (scopes: read_orders, read_products)
SHOPIFY_CLIENT_SECRET=""
# SHOPIFY_ADMIN_TOKEN=""         # alternative: legacy custom-app token (shpat_...)
# SHOPIFY_BUSINESS_NAME="Mi Meba Shop"
SYNC_SECRET=""                   # openssl rand -hex 24 — used by the daily sync job
SYNC_USER_EMAIL=""               # whose AXIOM data the daily job updates
