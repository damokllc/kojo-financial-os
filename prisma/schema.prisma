// Kojo Financial OS — Database Schema
// Stack: PostgreSQL + Prisma ORM
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  sessions      Session[]
  profile       Profile?
  financialAccounts FinancialAccount[]
  transactions  Transaction[]
  debts         Debt[]
  assets        Asset[]
  businesses    Business[]
  documents     Document[]
  creditReports CreditReport[]
  tasks         Task[]
  decisions     Decision[]
  openLoops     OpenLoop[]
  conversations Conversation[]
  alerts        Alert[]
  goals         Goal[]
  auditLogs     AuditLog[]
  snapshots     FinancialSnapshot[]
  memories      Memory[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// ─── PROFILE ──────────────────────────────────────────────────────────────────

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName    String?
  preferredName String?
  altName      String?  // Joey Wonda
  phone        String?
  city         String?
  state        String?
  country      String   @default("US")
  dateOfBirth  DateTime?
  ssn          String?  // encrypted — stored as AES-256 ciphertext only
  riskTolerance String  @default("medium") // low / medium / high
  primaryCurrency String @default("USD")
  ghanaOps     Boolean  @default(false)  // US+Ghana dual economy
  financialGoal String?
  northStar    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── FINANCIAL ACCOUNTS ───────────────────────────────────────────────────────

model FinancialAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  institution  String?
  type         AccountType
  subtype      String?
  balance      Decimal  @default(0) @db.Decimal(15,2)
  currency     String   @default("USD")
  isActive     Boolean  @default(true)
  plaidItemId  String?  // future Plaid integration
  plaidAccId   String?
  dataStatus   DataStatus @default(UNKNOWN)
  lastVerified DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  transactions Transaction[]
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  LOAN
  INVESTMENT
  RETIREMENT
  CRYPTO
  BUSINESS_CHECKING
  BUSINESS_SAVINGS
  MOBILE_MONEY  // Ghana MoMo etc
  OTHER
}

// ─── TRANSACTIONS ─────────────────────────────────────────────────────────────

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String?
  account     FinancialAccount? @relation(fields: [accountId], references: [id])
  date        DateTime
  description String
  amount      Decimal  @db.Decimal(15,2)  // positive=credit, negative=debit
  category    String?
  subcategory String?
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id])
  isRecurring Boolean  @default(false)
  dataStatus  DataStatus @default(USER_PROVIDED)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── DEBTS ────────────────────────────────────────────────────────────────────

model Debt {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditor         String
  accountNumber    String?  // masked
  type             DebtType
  originalBalance  Decimal  @db.Decimal(15,2)
  currentBalance   Decimal  @db.Decimal(15,2)
  apr              Decimal  @db.Decimal(6,4)  // e.g. 24.99 stored as 24.9900
  minimumPayment   Decimal  @db.Decimal(15,2)
  dueDate          Int?     // day of month
  termMonths       Int?
  startDate        DateTime?
  payoffDate       DateTime?
  status           DebtStatus @default(CURRENT)
  dataStatus       DataStatus @default(USER_PROVIDED)
  lastVerified     DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum DebtType {
  AUTO_LOAN
  STUDENT_LOAN
  CREDIT_CARD
  PERSONAL_LOAN
  MORTGAGE
  BUSINESS_LOAN
  MEDICAL
  COLLECTION
  OTHER
}

enum DebtStatus {
  CURRENT
  LATE_30
  LATE_60
  LATE_90
  COLLECTION
  CHARGED_OFF
  PAID
  DISPUTED
}

// ─── ASSETS ───────────────────────────────────────────────────────────────────

model Asset {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        AssetType
  value       Decimal   @db.Decimal(15,2)
  currency    String    @default("USD")
  dataStatus  DataStatus @default(ESTIMATED)
  lastValued  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum AssetType {
  VEHICLE
  REAL_ESTATE
  BUSINESS_EQUITY
  INVESTMENT
  CASH
  CRYPTO
  INTELLECTUAL_PROPERTY
  EQUIPMENT
  INVENTORY
  LAND
  OTHER
}

// ─── BUSINESSES & PROJECTS ────────────────────────────────────────────────────

model Business {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  legalName    String?
  entityType   String?  // LLC, sole prop, etc
  grade        BusinessGrade @default(D)
  stage        Int      @default(1)   // 1-10 stage gates
  industry     String?
  description  String?
  monthlyRevenue Decimal @default(0) @db.Decimal(15,2)
  monthlyExpenses Decimal @default(0) @db.Decimal(15,2)
  monthlyProfit  Decimal @default(0) @db.Decimal(15,2)
  isGhana      Boolean  @default(false)
  isActive     Boolean  @default(true)
  startDate    DateTime?
  killDate     DateTime?  // if grade=G or paused
  maxCapital   Decimal?   @db.Decimal(15,2)  // kill criteria
  targetRevenue Decimal?  @db.Decimal(15,2)
  deadline     DateTime?
  ownerDependency Int    @default(10)  // 1=independent, 10=fully dependent
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  transactions Transaction[]
  scores       BusinessScore[]
}

enum BusinessGrade {
  A  // Cash-flowing
  B  // Near-term revenue
  C  // Long-term asset
  D  // Speculative
  E  // Distraction
  F  // Pause
  G  // Exit
}

model BusinessScore {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scoredAt         DateTime @default(now())
  revenuePotential Int      // /10
  profitPotential  Int
  startupCost      Int
  speedToRevenue   Int
  recurringRevenue Int
  scalability      Int
  automation       Int
  moat             Int
  synergy          Int
  risk             Int
  complexity       Int
  infrastructure   Int
  ownerIndependence Int
  exitPotential    Int
  weightedTotal    Decimal  @db.Decimal(5,2)
  notes            String?
}

// ─── CREDIT REPORTS ───────────────────────────────────────────────────────────

model CreditReport {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bureau       CreditBureau
  reportDate   DateTime
  score        Int?
  uploadedAt   DateTime @default(now())
  documentId   String?
  document     Document? @relation(fields: [documentId], references: [id])
  parseStatus  String   @default("pending")  // pending/processing/done/failed
  rawText      String?  @db.Text
  accounts     CreditAccount[]
  inquiries    CreditInquiry[]
  publicRecords CreditPublicRecord[]
}

enum CreditBureau {
  EQUIFAX
  EXPERIAN
  TRANSUNION
}

model CreditAccount {
  id              String   @id @default(cuid())
  reportId        String
  report          CreditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  creditorName    String
  creditorNormalized String?  // normalized for cross-bureau comparison
  accountNumber   String?  // masked
  accountType     String?
  balance         Decimal? @db.Decimal(15,2)
  creditLimit     Decimal? @db.Decimal(15,2)
  highBalance     Decimal? @db.Decimal(15,2)
  paymentStatus   String?
  openDate        DateTime?
  closeDate       DateTime?
  lastActivity    DateTime?
  monthsHistory   Int?
  latePayments30  Int      @default(0)
  latePayments60  Int      @default(0)
  latePayments90  Int      @default(0)
  isCollection    Boolean  @default(false)
  isChargeOff     Boolean  @default(false)
  dataIssueType   DataIssueType?
  dataIssueNote   String?
  disputeStatus   DisputeStatus @default(NOT_DISPUTED)
  disputes        CreditDispute[]
}

model CreditInquiry {
  id         String   @id @default(cuid())
  reportId   String
  report     CreditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  creditor   String
  date       DateTime?
  type       String?  // hard / soft
}

model CreditPublicRecord {
  id         String   @id @default(cuid())
  reportId   String
  report     CreditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type       String
  court      String?
  amount     Decimal? @db.Decimal(15,2)
  date       DateTime?
  status     String?
}

model CreditDispute {
  id              String   @id @default(cuid())
  accountId       String
  account         CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  basis           String   // reason for dispute
  evidenceDesc    String?
  submittedAt     DateTime?
  responseDeadline DateTime?
  responseAt      DateTime?
  result          String?  // verified / corrected / deleted / no-change
  outcome         String?
  nextAction      String?
  notes           String?
  status          DisputeStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum DataIssueType {
  INACCURATE
  INCOMPLETE
  DUPLICATE
  NOT_MINE
  WRONG_DATE
  WRONG_BALANCE
  WRONG_STATUS
  UNKNOWN
}

enum DisputeStatus {
  NOT_DISPUTED
  PENDING
  SUBMITTED
  IN_REVIEW
  RESOLVED_CORRECTED
  RESOLVED_DELETED
  RESOLVED_VERIFIED
  ESCALATED
}

// ─── DOCUMENTS ────────────────────────────────────────────────────────────────

model Document {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  category     DocumentCategory
  fileKey      String   // encrypted storage key
  fileType     String   // pdf, jpg, etc
  fileSizeBytes Int
  uploadedAt   DateTime @default(now())
  expiresAt    DateTime?
  extractedData Json?
  confidence   Decimal? @db.Decimal(3,2)
  relatedEntity String?  // business name, creditor, etc
  relatedDebtId String?
  notes        String?
  creditReports CreditReport[]
}

enum DocumentCategory {
  CREDIT_REPORT
  BANK_STATEMENT
  TAX_DOCUMENT
  LOAN_DOCUMENT
  INSURANCE
  CONTRACT
  BUSINESS_DOCUMENT
  RECEIPT
  INVOICE
  LEGAL
  PROPERTY
  VEHICLE
  INVESTMENT_STATEMENT
  IDENTITY
  OTHER
}

// ─── TASKS & OPEN LOOPS ───────────────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  priority    Priority  @default(MEDIUM)
  category    String?
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  businessId  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model OpenLoop {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  priority    Priority  @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  nextAction  String?
  dueDate     DateTime?
  followUpAt  DateTime?
  closedAt    DateTime?
  closedNote  String?
  source      String?   // conversation id that created it
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

// ─── DECISION JOURNAL ─────────────────────────────────────────────────────────

model Decision {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  decision       String
  situation      String?  @db.Text
  optionsConsidered String? @db.Text
  capitalRequired Decimal? @db.Decimal(15,2)
  expectedReturn  Decimal? @db.Decimal(15,2)
  expectedRisk    String?
  reasoning       String?  @db.Text
  aiRecommendation String? @db.Text
  kojoDecision    String?
  expectedOutcome String?  @db.Text
  actualOutcome   String?  @db.Text
  lesson          String?  @db.Text
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── AI MEMORY & CONVERSATIONS ────────────────────────────────────────────────

model Memory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    MemoryCategory
  key         String
  value       String   @db.Text
  confidence  String   @default("USER_PROVIDED")
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category, key])
}

enum MemoryCategory {
  PERSONAL
  FINANCIAL
  BUSINESS
  PROJECT
  DECISION
  CONVERSATION
  OPEN_LOOP
  PREFERENCE
  GOAL
  WEEKLY_REVIEW
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  ConversationMessage[]
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // user / assistant / system
  content        String       @db.Text
  toolsUsed      Json?
  tokensUsed     Int?
  createdAt      DateTime     @default(now())
}

// ─── ALERTS ───────────────────────────────────────────────────────────────────

model Alert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AlertType
  priority    Priority
  title       String
  body        String
  isRead      Boolean   @default(false)
  isDismissed Boolean   @default(false)
  actionUrl   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

enum AlertType {
  CASH
  BILL
  CREDIT
  DEBT
  BUSINESS
  PROJECT
  OPPORTUNITY
  IDENTITY
  SYSTEM
}

// ─── GOALS ────────────────────────────────────────────────────────────────────

model Goal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String
  targetAmount Decimal? @db.Decimal(15,2)
  targetDate  DateTime?
  currentAmount Decimal @default(0) @db.Decimal(15,2)
  status      String   @default("active")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── FINANCIAL SNAPSHOTS (for trend tracking) ─────────────────────────────────

model FinancialSnapshot {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotDate     DateTime @default(now())
  totalAssets      Decimal  @db.Decimal(15,2)
  totalLiabilities Decimal  @db.Decimal(15,2)
  netWorth         Decimal  @db.Decimal(15,2)
  liquidCash       Decimal  @db.Decimal(15,2)
  monthlyIncome    Decimal  @db.Decimal(15,2)
  monthlyExpenses  Decimal  @db.Decimal(15,2)
  monthlyDebtService Decimal @db.Decimal(15,2)
  creditScore      Int?
  businessRevenue  Decimal  @db.Decimal(15,2)
  businessProfit   Decimal  @db.Decimal(15,2)
  financialFreedomScore Int?
  creditHealthScore Int?
  dataQualityScore  Int?
  notes            String?
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  entity      String?
  entityId    String?
  dataUsed    Json?
  aiRecommendation String? @db.Text
  kojoApproved Boolean?
  result      String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// ─── SHARED ENUMS ─────────────────────────────────────────────────────────────

enum DataStatus {
  VERIFIED
  USER_PROVIDED
  IMPORTED
  HISTORICAL
  ESTIMATED
  ASSUMED
  UNVERIFIED
  UNKNOWN
}
